---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import CopyButton from "../components/CopyButton.astro";
import Terminal from "../components/Terminal.astro";
import type { Line } from "../components/terminal";
import Base from "../layouts/Base.astro";

// Single-source content from the repo so the site can't drift from the docs.
// The build runs from site/, so the repo root is one level up.
const repoRoot = join(process.cwd(), "..");
const pkg = JSON.parse(readFileSync(join(repoRoot, "package.json"), "utf8")) as {
	version: string;
};
const readme = readFileSync(join(repoRoot, "README.md"), "utf8");
const agentSection = readme.split("## Set up with your AI agent")[1] ?? "";
const agentPrompt = /```text\n([\s\S]*?)\n```/.exec(agentSection)?.[1]?.trim();
if (!agentPrompt) {
	throw new Error("Couldn't find the agent prompt in README.md (## Set up with your AI agent).");
}

const repo = "https://github.com/ian/rosetta";
const skillUrl = "https://raw.githubusercontent.com/ian/rosetta/main/skills/rosetta/SKILL.md";
const install = pkg.version.includes("-") ? "rosetta-i18n@next" : "rosetta-i18n";
const skillInstall = `mkdir -p .claude/skills/rosetta && curl -fsSL ${skillUrl} -o .claude/skills/rosetta/SKILL.md`;

const title = "Rosetta: a free, open-source alternative to Lingo.dev";
const description =
	"Edit your source strings, run rosetta push, and every locale gets the new and changed strings, translated with your own LLM key and validated before anything is written. No account, no daily token cap, no platform fee.";

// Hero demo. Output mirrors the real CLI's formatting.
const demo: Line[] = [
	{ kind: "out", tone: "dim", text: "# you edited 4 strings in messages/en.json" },
	{ kind: "cmd", text: "npx rosetta push" },
	{ kind: "out", tone: "ok", text: "✓ es     messages/es.json     4 translated · 1 removed" },
	{ kind: "out", tone: "ok", text: "✓ fr     messages/fr.json     4 translated · 1 removed" },
	{ kind: "out", tone: "ok", text: "✓ de     messages/de.json     4 translated · 1 removed" },
	{ kind: "out", tone: "ok", text: "✓ ja     messages/ja.json     4 translated · 1 removed" },
	{ kind: "out", tone: "ok", text: "✓ pt-BR  messages/pt-BR.json  4 translated · 1 removed" },
	{ kind: "out", tone: "ok", text: "✓ zh-CN  messages/zh-CN.json  4 translated · 1 removed" },
	{ kind: "out", tone: "dim", text: "6 requests · 5,412 input / 1,988 output tokens" },
	{ kind: "cmd", text: "git diff --stat" },
	{ kind: "out", text: " .rosetta/lock.json    | 30 +++++++-------" },
	{ kind: "out", text: " messages/de.json      |  9 ++++----" },
	{ kind: "out", text: " messages/en.json      |  9 ++++----" },
	{ kind: "out", text: " messages/es.json      |  9 ++++----" },
	{ kind: "out", text: " messages/fr.json      |  9 ++++----" },
	{ kind: "out", text: " messages/ja.json      |  9 ++++----" },
	{ kind: "out", text: " messages/pt-BR.json   |  9 ++++----" },
	{ kind: "out", text: " messages/zh-CN.json   |  9 ++++----" },
	{ kind: "out", text: " 8 files changed, 57 insertions(+), 36 deletions(-)" },
	{ kind: "cmd", text: "git diff messages/ja.json" },
	{ kind: "out", tone: "hunk", text: "@@ -18,9 +18,9 @@ \"Pricing\": {" },
	{ kind: "out", tone: "del", text: '-    "cta": "無料で始める",' },
	{ kind: "out", tone: "add", text: '+    "cta": "Proを14日間無料で試す",' },
	{ kind: "out", tone: "del", text: '-    "trial": "{days}日間の無料トライアル",' },
	{ kind: "out", tone: "add", text: '+    "trial": "{days}日間無料・カード登録不要",' },
	{ kind: "cmd", text: 'git commit -am "Update pricing copy"' },
	{ kind: "out", text: "[main 4c1e7a2] Update pricing copy" },
	{ kind: "out", text: " 8 files changed, 57 insertions(+), 36 deletions(-)" },
	{ kind: "cmd", text: "git push" },
	{ kind: "out", tone: "dim", text: "To github.com:acme/web.git" },
	{ kind: "out", tone: "dim", text: "   9b3d0f1..4c1e7a2  main -> main" },
];

const reasons = [
	{
		title: "No daily token cap",
		icon: '<path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"/>',
		body: "Rosetta sends requests straight to your model provider, so the only limits are your provider's. Translate a whole site in one run.",
	},
	{
		title: "No platform fee, no subscription",
		icon: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
		body: "There's no base price, no per-engine charge, and no markup per million tokens. You pay your LLM provider for the tokens you use, and nothing else.",
	},
	{
		title: "Any model, your key",
		icon: '<path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/>',
		body: "OpenRouter by default, or any OpenAI-compatible endpoint: OpenAI, a gateway, or Ollama on your own machine. Switch models with one line of config.",
	},
	{
		title: "Everything lives in your repo",
		icon: '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
		body: "Config, lockfile, brand voice, and glossary are plain files in .rosetta/. Translations are reviewable diffs with git history, not rows in a dashboard.",
	},
	{
		title: "Built for coding agents",
		icon: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
		body: "--json on every command, stable exit codes, no prompts in CI, and a skill your agent can install. \"Add a German string for this\" just works.",
	},
	{
		title: "Open source, MIT",
		icon: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>',
		body: "Read it, fork it, run it anywhere. No account to create, nothing to cancel, and no vendor between you and your translations.",
	},
];

const pricing = [
	["Monthly base price", "$0", "$99", "$0"],
	["Throughput", "100K tokens / day", "5M tokens / day", "Your provider's limits"],
	["LLM tokens", "Passed through", "Passed through", "Paid to your provider"],
	["Platform fee", "$2 / million tokens", "$2 / million tokens", "None"],
	["Engines", "$0.50 / engine / month", "$0.50 / engine / month", "Free (it's a config file)"],
	["Bring your own model key", "Enterprise only", "Enterprise only", "Always"],
	["Where your config lives", "Their platform", "Their platform", "Your repo"],
];

const features = [
	{
		title: "Only changed strings cost tokens",
		body: "The lockfile records the source text behind every translation. Edit one string and only that string is retranslated, in every locale.",
	},
	{
		title: "Existing translations adopted free",
		body: "Switching from another tool? The first push records what you already have without calling a model.",
	},
	{
		title: "Broken translations caught",
		body: "Dropped {placeholders}, mangled ICU plurals, and broken <tags> are flagged and retranslated, including ones already in your files.",
	},
	{
		title: "Never a partial file",
		body: "A locale with a key that still fails after retries isn't written, and the error is reported. Every other locale still lands.",
	},
	{
		title: "Key controls",
		body: "lockedKeys copy URLs and prices verbatim, preservedKeys protect reviewed copy, and ignoredKeys keep internal strings out of targets.",
	},
	{
		title: "Brand voice, rules, glossary",
		body: "Per-locale voice (inline or in Markdown files), linguistic rules, exact term renderings, and a never-translate list.",
	},
];

const configExample = `{
  "sourceLocale": "en",
  "targetLocales": ["es", "fr", "de", "ja", "pt-BR", "zh-CN"],
  "files": [
    { "pattern": "messages/en.json", "context": "Acme web app UI" }
  ],
  "engine": {
    "model": "anthropic/claude-sonnet-4.5",
    "brandVoice": { "*": "Friendly, plain, and direct." },
    "glossary": { "*": { "Acme": "Acme" } }
  }
}`;

const workflowExample = `on:
  pull_request:
  push: { branches: [main] }
jobs:
  i18n:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ian/rosetta@v${pkg.version}
        with:
          # PRs: check (no key needed). main: translate + open a PR.
          mode: \${{ github.event_name == 'pull_request'
            && 'check' || 'pull-request' }}
        env:
          OPENROUTER_API_KEY: \${{ secrets.OPENROUTER_API_KEY }}`;

const faq = [
	{
		q: "Is there a hosted version or an account?",
		a: "No. Rosetta is a CLI and a library. It runs on your machine or CI runner and talks directly to your model provider. The only credential is that provider's API key.",
	},
	{
		q: "What does it cost to run?",
		a: "Only your model provider's tokens, and only for new, changed, or broken strings. Run <code>rosetta push --estimate</code> to see key counts and a token estimate before anything is sent.",
	},
	{
		q: "Which file formats are supported?",
		a: `JSON and JSONC today: next-intl, i18next, vue-i18n, and any key-value catalog. In JSONC files, comments become translator notes. Markdown/MDX is next (<a href="${repo}/issues/1">#1</a>).`,
	},
	{
		q: "Which models work?",
		a: "Any chat model behind an OpenAI-compatible endpoint. Rosetta asks for JSON output, strips code fences, and validates every value, so most instruction-following models do fine.",
	},
	{
		q: "I'm on Lingo.dev. How do I move over?",
		a: `Run <code>rosetta init --from-lingo</code>. It imports <code>.lingo/config.json</code> (or the legacy <code>i18n.json</code>), and the first push adopts your existing translations for free. The vocabulary is the same: <code>lockedKeys</code>, <code>push --key</code>, <code>check</code>, <code>purge</code>. See the <a href="${repo}/blob/main/docs/migrating-from-lingo.md">migration guide</a>.`,
	},
	{
		q: "How do translations get into my repo?",
		a: `However you like: run <code>push</code> locally or from an agent, gate PRs with <code>check</code>, or let the GitHub Action commit or open a rolling PR after merges. See <a href="${repo}/blob/main/docs/delivery.md">CI &amp; delivery</a>.`,
	},
	{
		q: "Is it production-ready?",
		a: `It's in beta (v${pkg.version}). The spec is stable, and it's covered by tests and a CI end-to-end run of the GitHub Action. Pin the version, and please <a href="${repo}/issues">open issues</a>.`,
	},
];
---

<Base title={title} description={description}>
	<header class="wrap nav">
		<a class="logo" href="/"><img src="/favicon.svg" alt="" width="24" height="24" /> Rosetta</a>
		<nav>
			<a href="#get-started">Get started</a>
			<a href={`${repo}#readme`}>Docs</a>
			<a href={repo}>GitHub</a>
		</nav>
	</header>

	<main>
		<section class="wrap hero">
			<div class="hero-copy">
				<p class="eyebrow">v{pkg.version} · MIT · no account</p>
				<h1>Localization you run yourself.</h1>
				<p class="lede">
					A free, open-source alternative to Lingo.dev. Edit your source strings, run{" "}
					<code>rosetta push</code>, and every locale gets the new and changed strings, translated with your own
					LLM key and validated before anything is written.
				</p>
				<div class="ctas">
					<CopyButton text={agentPrompt} variant="primary" label="Copy the prompt for your AI agent">
						Copy the prompt for your AI agent
					</CopyButton>
					<a class="btn" href="#get-started">Get started</a>
				</div>
				<p class="hint">Paste it into Claude Code, Cursor, Codex, or opencode from your project root.</p>
			</div>
			<div class="hero-demo">
				<Terminal lines={demo} />
			</div>
		</section>

		<section class="wrap">
			<h2>Why Rosetta</h2>
			<div class="grid three">
				{
					reasons.map((reason) => (
						<div class="card">
							<span class="card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={reason.icon} />
							</span>
							<h3>{reason.title}</h3>
							<p>{reason.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="wrap">
			<h2>The math</h2>
			<p class="muted">
				Lingo.dev's published plans next to Rosetta. With Rosetta you still pay for tokens, but directly to your
				model provider, with no cap and no markup.
			</p>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th></th>
							<th>Lingo.dev Sandbox</th>
							<th>Lingo.dev Production</th>
							<th class="us">Rosetta</th>
						</tr>
					</thead>
					<tbody>
						{
							pricing.map(([label, sandbox, production, ours]) => (
								<tr>
									<th>{label}</th>
									<td>{sandbox}</td>
									<td>{production}</td>
									<td class="us">{ours}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="muted small">
				Lingo.dev figures are from <a href="https://lingo.dev/en/pricing">lingo.dev/pricing</a> as of September 2026.
				Enterprise pricing is custom.
			</p>
		</section>

		<section class="wrap" id="get-started">
			<h2>Get started</h2>
			<p class="muted">
				Works with any JSON/JSONC locale files (next-intl, i18next, vue-i18n, …) and Node 20+. Hand it to your
				coding agent, or set it up yourself in a few minutes.
			</p>

			<div class="tabs" data-tabs>
				<div class="tablist" role="tablist" aria-label="How to get started">
					<button type="button" role="tab" id="tab-agents" aria-controls="panel-agents" aria-selected="true" data-tab="agents">
						Agents <span class="tab-hint">one prompt</span>
					</button>
					<button type="button" role="tab" id="tab-manual" aria-controls="panel-manual" aria-selected="false" tabindex="-1" data-tab="manual">
						Manual <span class="tab-hint">six steps</span>
					</button>
				</div>

				<div class="tabpanel" role="tabpanel" id="panel-agents" aria-labelledby="tab-agents" tabindex="0">
					<p class="panel-lede">
						Paste this into Claude Code, Cursor, Codex, or opencode from your project root. Your agent reads the
						Rosetta skill and does the whole setup, then opens one PR for you to review.
					</p>
					<div class="prompt">
						<CopyButton target="agent-prompt" variant="ghost" class="prompt-copy" label="Copy" />
						<pre id="agent-prompt">{agentPrompt}</pre>
					</div>

					<h3 class="sub">What your agent will do</h3>
					<ol class="agent-steps">
						<li><strong>Discover.</strong> Finds your i18n runtime, locale files, locale list, and current translation setup, then reports back.</li>
						<li><strong>Configure.</strong> Writes <code>.rosetta/config.json</code> and carries over your brand voice, context, and do-not-translate terms.</li>
						<li><strong>Adopt.</strong> Records your existing translations for free, and lists any that are broken today.</li>
						<li><strong>Guard.</strong> Adds tests that keep the config in sync with your app's locale list.</li>
						<li><strong>Wire up CI.</strong> Keeps your existing flow, or proposes <code>check</code>, commit, or PR mode.</li>
						<li><strong>Clean up.</strong> Removes the old tooling, documents the workflow in <code>AGENTS.md</code>, and opens one PR.</li>
					</ol>
					<p class="muted small">It asks before anything expensive: <code>push --force</code>, large translation runs, or choosing how translations land.</p>

					<h3 class="sub">Keep your agent fluent</h3>
					<p class="muted small">
						Install the <a href={skillUrl}>Rosetta skill</a> so everyday requests ("add a German string", "why is the
						i18n job red?") just work. For agents that can't fetch URLs, use the{" "}
						<a href={`${repo}/blob/main/docs/agent-prompt.md`}>self-contained prompt</a>.
					</p>
					<div class="code">
						<CopyButton text={skillInstall} variant="inline" label="Copy skill install command" />
						<pre><code><span class="c"># Claude Code (other agents: see docs/agent-prompt.md)</span>
{skillInstall}</code></pre>
					</div>
				</div>

				<div class="tabpanel" role="tabpanel" id="panel-manual" aria-labelledby="tab-manual" tabindex="0" hidden>
					<ol class="steps">
						<li>
							<div class="step-text">
								<h3>Install</h3>
								<p>Add Rosetta as a dev dependency. The package is <code>rosetta-i18n</code>, and it installs a
									<code>rosetta</code> command.</p>
							</div>
							<div class="code">
								<CopyButton text={`npm install -D ${install}`} variant="inline" label="Copy install command" />
								<pre><code>npm install -D {install}</code></pre>
							</div>
						</li>
						<li>
							<div class="step-text">
								<h3>Create the config</h3>
								<p>
									<code>init</code> finds your source files (<code>messages/en.json</code>,
									<code>locales/en/*.json</code>, <code>pages.en.json</code>, …), infers target locales from the
									files next to them, and writes <code>.rosetta/config.json</code>. Coming from Lingo.dev? Use
									<code>--from-lingo</code>.
								</p>
							</div>
							<div class="code">
								<CopyButton text="npx rosetta init" variant="inline" label="Copy init command" />
								<pre><code>npx rosetta init
<span class="c"># or: npx rosetta init --pattern messages/en.json --target es,fr,de</span>
<span class="c"># or: npx rosetta init --from-lingo</span></code></pre>
							</div>
						</li>
						<li>
							<div class="step-text">
								<h3>Tune the engine</h3>
								<p>
									Pick a model and give it your brand voice and never-translate terms. Add <code>lockedKeys</code>
									for anything that must stay identical (URLs, prices), and a <code>context</code> per file.
								</p>
							</div>
							<div class="code">
								<span class="file">.rosetta/config.json</span>
								<pre><code>{configExample}</code></pre>
							</div>
						</li>
						<li>
							<div class="step-text">
								<h3>Add your model key</h3>
								<p>
									Rosetta has no key of its own. Use your OpenRouter key, or point <code>engine.baseURL</code> at
									any OpenAI-compatible endpoint and set <code>engine.apiKeyEnv</code> to its variable.
								</p>
							</div>
							<div class="code">
								<pre><code>export OPENROUTER_API_KEY=sk-or-...</code></pre>
							</div>
						</li>
						<li>
							<div class="step-text">
								<h3>Preview, then push</h3>
								<p>
									<code>status</code> shows what would happen, with no key and no cost. The first <code>push</code>
									adopts your existing translations for free and translates only what's missing, changed, or broken.
								</p>
							</div>
							<div class="code">
								<CopyButton text="npx rosetta status && npx rosetta push" variant="inline" label="Copy commands" />
								<pre><code>npx rosetta status   <span class="c"># es  3 to translate · 412 to adopt</span>
npx rosetta push     <span class="c"># writes locale files + .rosetta/lock.json</span></code></pre>
							</div>
						</li>
						<li>
							<div class="step-text">
								<h3>Commit, then keep it in sync</h3>
								<p>
									Commit <code>.rosetta/</code> with your locale files. From then on it's{" "}
									<strong>edit English → push → commit</strong>, run yourself, by an agent, or by the GitHub Action.
								</p>
							</div>
							<div class="code">
								<span class="file">.github/workflows/i18n.yml</span>
								<pre><code>{workflowExample}</code></pre>
							</div>
						</li>
					</ol>
				</div>
			</div>
			<noscript><style>.tabpanel[hidden] { display: block; } .tablist { display: none; }</style></noscript>
		</section>

		<section class="wrap">
			<h2>How it works</h2>
			<p class="muted">
				Rosetta keeps a lockfile, <code>.rosetta/lock.json</code>, that records a fingerprint of the source string
				behind every translation. On each push, every key is translated, retranslated, kept, adopted, copied, or
				removed, and nothing else is touched.
			</p>
			<div class="grid three">
				{
					features.map((feature) => (
						<div class="card">
							<h3>{feature.title}</h3>
							<p>{feature.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="wrap">
			<h2>Questions</h2>
			<div class="faq">
				{
					faq.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p set:html={item.a} />
						</details>
					))
				}
			</div>
		</section>

		<section class="wrap final">
			<h2>Try it on your project</h2>
			<p class="muted">One prompt, one PR. Or three commands, if you'd rather do it yourself.</p>
			<div class="ctas center">
				<CopyButton text={agentPrompt} variant="primary" label="Copy the prompt for your AI agent">
					Copy the prompt for your AI agent
				</CopyButton>
				<a class="btn" href={repo}>View on GitHub</a>
			</div>
		</section>
	</main>

	<footer class="wrap footer">
		<span>MIT © Ian Hunter</span>
		<a href={`${repo}#readme`}>Docs</a>
		<a href={`${repo}/blob/main/docs/delivery.md`}>CI &amp; delivery</a>
		<a href={`${repo}/blob/main/docs/migrating-from-lingo.md`}>Migrating from Lingo.dev</a>
		<a href="https://www.npmjs.com/package/rosetta-i18n">npm</a>
	</footer>
</Base>

<script>
	for (const tabs of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
		const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

		const select = (name: string, focus = false) => {
			for (const button of buttons) {
				const active = button.dataset.tab === name;
				button.setAttribute("aria-selected", String(active));
				button.tabIndex = active ? 0 : -1;
				const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
				if (panel) panel.hidden = !active;
				if (active && focus) button.focus();
			}
		};

		buttons.forEach((button, i) => {
			button.addEventListener("click", () => select(button.dataset.tab ?? ""));
			button.addEventListener("keydown", (event) => {
				const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
				if (!step) return;
				event.preventDefault();
				const next = buttons[(i + step + buttons.length) % buttons.length];
				select(next.dataset.tab ?? "", true);
			});
		});

		// Deep links: #agents / #manual open that tab and scroll to the section.
		const fromHash = () => {
			const name = location.hash.slice(1);
			if (buttons.some((button) => button.dataset.tab === name)) {
				select(name);
				tabs.closest("section")?.scrollIntoView();
			}
		};
		window.addEventListener("hashchange", fromHash);
		fromHash();
	}
</script>

