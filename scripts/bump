#!/bin/bash
set -euo pipefail

# Bump the package version, commit, and push to main. Pushing a new version
# triggers .github/workflows/npm-publish.yml, which tests, builds, publishes to
# npm, tags v<version>, and creates the GitHub Release.
#
# Usage:
#   pnpm bump [patch|minor|major]                        # stable release
#   pnpm bump [premajor|preminor|prepatch|prerelease]    # -beta.N prerelease
#   pnpm bump 1.0.0-beta.2                               # explicit version

VERSION_TYPE=${1:-patch}

case "$VERSION_TYPE" in
	patch | minor | major) npm version "$VERSION_TYPE" --no-git-tag-version ;;
	premajor | preminor | prepatch | prerelease) npm version "$VERSION_TYPE" --preid beta --no-git-tag-version ;;
	[0-9]*.[0-9]*.[0-9]*) npm version "$VERSION_TYPE" --no-git-tag-version ;;
	*)
		echo "Invalid version type. Use patch|minor|major, premajor|preminor|prepatch|prerelease, or an explicit version."
		exit 1
		;;
esac

VERSION=$(node -p "require('./package.json').version")

git add package.json
git commit -m "chore: bump version to $VERSION"
git push

echo ""
echo "Bumped to v$VERSION and pushed. npm-publish is now publishing it:"
echo "  gh run watch \$(gh run list --workflow npm-publish.yml -L 1 --json databaseId -q '.[0].databaseId')"
