#!/bin/bash
set -euo pipefail

# Create a GitHub Release for the latest tag. Publishing the release triggers
# the npm-publish workflow (OIDC trusted publishing) — no npm token required.
# Usage: pnpm release

TAG=$(git describe --tags --abbrev=0)

if gh release view "$TAG" >/dev/null 2>&1; then
	echo "Release $TAG already exists — nothing to do."
	exit 0
fi

# Notes cover the previous tag (or the root commit) up to this tag.
PREV=$(git describe --tags --abbrev=0 "$TAG^" 2>/dev/null || git rev-list --max-parents=0 HEAD)
NOTES=$(./scripts/release-notes "$PREV" "$TAG")

gh release create "$TAG" --title "$TAG" --notes "$NOTES"

echo ""
echo "Created GitHub release $TAG."
echo "npm-publish workflow is now publishing to npm via OIDC."
