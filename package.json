{
	"name": "rosetta-i18n",
	"version": "1.0.0-beta.2",
	"author": "Ian Hunter <ian@01.studio>",
	"license": "MIT",
	"description": "Self-hosted AI translation engine — translate key-value content across locales through any OpenAI-compatible LLM, with brand voice and glossary enforcement.",
	"homepage": "https://github.com/ian/rosetta#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ian/rosetta.git"
	},
	"bugs": {
		"url": "https://github.com/ian/rosetta/issues"
	},
	"keywords": [
		"translation",
		"i18n",
		"localization",
		"llm",
		"ai",
		"openai",
		"openrouter",
		"rosetta-i18n"
	],
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"schema",
		"skills",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"bin": {
		"rosetta": "dist/esm/cli.js",
		"rosetta-i18n": "dist/esm/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/esm/index.js"
		},
		"./next": {
			"types": "./dist/types/next.d.ts",
			"default": "./dist/esm/next.js"
		},
		"./react": {
			"types": "./dist/types/react.d.ts",
			"default": "./dist/esm/react.js"
		},
		"./astro": {
			"types": "./dist/types/locale/astro.d.ts",
			"default": "./dist/esm/astro.js"
		},
		"./locale": {
			"types": "./dist/types/locale/core.d.ts",
			"default": "./dist/esm/locale.js"
		},
		"./config": {
			"types": "./dist/types/config.d.ts",
			"default": "./dist/esm/config.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "rm -rf ./dist",
		"build": "rollup -c && tsc -p tsconfig.build.json && chmod +x dist/esm/cli.js",
		"build:watch": "rollup -c -w",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"bump": "./scripts/bump",
		"release": "./scripts/release",
		"format": "biome format",
		"format:fix": "biome format --write",
		"lint": "biome check",
		"lint:fix": "biome check --write"
	},
	"peerDependencies": {
		"astro": ">=4.0.0",
		"next": ">=14.0.0",
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"astro": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "22.15.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^26.1.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rollup": "^4.63.1",
		"rollup-plugin-esbuild": "^6.1.1",
		"typescript": "5.9.2",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@9.7.1"
}
