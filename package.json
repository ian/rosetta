{
	"name": "rosetta-i18n",
	"version": "0.1.2",
	"author": "Ian Hunter <ian@01.studio>",
	"license": "MIT",
	"description": "Self-hosted AI translation engine — translate key-value content across locales through any OpenAI-compatible LLM, with brand voice and glossary enforcement.",
	"homepage": "https://github.com/ian/rosetta#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ian/rosetta.git"
	},
	"bugs": {
		"url": "https://github.com/ian/rosetta/issues"
	},
	"keywords": [
		"translation",
		"i18n",
		"localization",
		"llm",
		"ai",
		"openai",
		"openrouter",
		"rosetta-i18n"
	],
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/esm/index.js"
		},
		"./config": {
			"types": "./dist/types/config.d.ts",
			"default": "./dist/esm/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "rm -rf ./dist",
		"build": "rollup -c && tsc -p tsconfig.build.json",
		"build:watch": "rollup -c -w",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"bump": "./scripts/bump",
		"release": "./scripts/release",
		"format": "biome format",
		"format:fix": "biome format --write",
		"lint": "biome check",
		"lint:fix": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "22.15.3",
		"rollup": "^4.63.1",
		"rollup-plugin-esbuild": "^6.1.1",
		"typescript": "5.9.2",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@9.7.1"
}
